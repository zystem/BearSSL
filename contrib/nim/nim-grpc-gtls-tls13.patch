+/* Keep the client's session for the next connection. With TLS 1.3 the ticket arrives after
+ * the handshake, with the first records that follow it, so this is called again from
+ * gtls_push_records until a ticket has been kept. */
+static void keep_session(gtls_conn *t) {
+    if (t->is_server || t->saved || !t->watch.chain_seen || !t->watch.validated ||
+        !t->conf || t->conf->lifetime <= 0) return;
+    br_ssl_session_parameters p;
+    br_ssl_engine_get_session_parameters(t->eng, &p);
+    int usable = p.version == BR_TLS13
+                     ? (br_ssl_engine_tls13_ticket_count(t->eng) > 0 && p.ticket_len > 0)
+                     : (p.session_id_len > 0 && p.session_id_len <= sizeof p.session_id);
+    if (!usable) return;
+    gtls_conf *c = t->conf;
+    pthread_mutex_lock(&c->mu);
+    c->csess = p;
+    c->have_session = 1;
+    c->ctime = now_s();
+    snprintf(c->cname, sizeof c->cname, "%s", t->sni);
+    pthread_mutex_unlock(&c->mu);
+    t->saved = 1;
+    memset(&p, 0, sizeof p);
+}
