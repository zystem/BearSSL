+/* TLS 1.3: the same ALPN rule, then the inner policy's choice and signature. */
+static int policy_choose13(const br_ssl_server_policy_class **pctx, const br_ssl_server_context *cc,
+                           uint32_t sig_algs, br_ssl_server_choices *choices) {
+    gtls_conn *t = (gtls_conn *)((char *)pctx - offsetof(gtls_conn, policy_vt));
+    if (br_ssl_engine_get_selected_protocol((br_ssl_engine_context *)&cc->eng) == NULL) {
+        t->alpn_refused = 1;
+        return 0;
+    }
+    if ((*t->inner)->choose13 == NULL) return 0;
+    return (*t->inner)->choose13(t->inner, cc, sig_algs, choices);
+}
+static size_t policy_sign13(const br_ssl_server_policy_class **pctx, const br_hash_class *hf,
+                            const br_prng_class **rng, const unsigned char *hv, size_t hv_len,
+                            unsigned char *sig, size_t sig_len) {
+    gtls_conn *t = (gtls_conn *)((char *)pctx - offsetof(gtls_conn, policy_vt));
+    return (*t->inner)->do_sign13(t->inner, hf, rng, hv, hv_len, sig, sig_len);
+}
